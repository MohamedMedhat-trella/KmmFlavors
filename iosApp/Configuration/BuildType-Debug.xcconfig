// Debug-only compiler settings, shared by every brand x environment combination built in
// debug. Mirrors androidApp's (default, unmodified) "debug" Gradle build type.

// The Kotlin Gradle plugin infers this from a "Debug"/"Release" substring in the Xcode
// configuration name; our flavor-named configurations need it spelled out explicitly.
KOTLIN_FRAMEWORK_BUILD_TYPE = debug

DEBUG_INFORMATION_FORMAT = dwarf
ENABLE_TESTABILITY = YES
GCC_DYNAMIC_NO_PIC = NO
GCC_OPTIMIZATION_LEVEL = 0
GCC_PREPROCESSOR_DEFINITIONS = DEBUG=1 $(inherited)
MTL_ENABLE_DEBUG_INFO = INCLUDE_SOURCE
ONLY_ACTIVE_ARCH = YES
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG $(inherited)
SWIFT_OPTIMIZATION_LEVEL = -Onone
